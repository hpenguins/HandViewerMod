<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HandViewerMod</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- SDK 与游戏程序集都由 tools\fetch-refs.ps1 放进 refs\，不入库 -->
    <Reference Include="CesiumLoader.SDK">
      <HintPath>$(CesiumSdkDir)CesiumLoader.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstralParty.Runtime">
      <HintPath>$(GameRefsDir)AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRefsDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(GameRefsDir)UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf.Runtime">
      <HintPath>$(GameRefsDir)Google.Protobuf.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 单元测试工程单独编译, 不并入模组程序集 -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <None Update="HandViewerMod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
